# Formal training — keep local-only payloads out of ordinary Git
experiments/formal/**/checkpoints/
experiments/formal/**/output*/
experiments/formal/stage6a_formal_training/runs/
experiments/formal/stage6a_formal_training/local_outputs/

# Stage 7A-1 pilot large local artifacts (tracked via release archives + hashes)
experiments/pilots/stage7a1_baseline_budget/output/runs/
experiments/pilots/stage7a1_baseline_budget/output/checkpoints/
experiments/pilots/stage7a1_baseline_budget/output/weights/
experiments/pilots/stage7a1_baseline_budget/output/trajectories/
experiments/pilots/stage7a1_baseline_budget/output/diagnostics/
experiments/pilots/stage7a1_baseline_budget/release/
**/*_full.pt
**/weights_step_*.pt

# Full replay / intermediate checkpoint payloads
**/ckpt_step_*.pt
**/*_emergency.pt
**/full_replay*
**/transition_stream*

# Secrets / local notify URLs must never be committed
.env
.env.*
**/webhook_url*
formal_notify_webhook*

# Python
.venv_stage2b1/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/

# Local debug leftovers
_git_status.txt
_debug_*.py
get-pip.py

# Experiment run artifacts (keep directory placeholders via .gitkeep)
experiments/pre_impl/*/data/raw/*/
experiments/pre_impl/*/data/processed/*/
experiments/pre_impl/*/reports/*/
experiments/pre_impl/*/logs/*/
experiments/pre_impl/*/artifacts/*/

env_search.txt
project_tree.txt
